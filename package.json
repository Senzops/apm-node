{
  "name": "@senzops/apm-node",
  "version": "1.2.8",
  "description": "Universal APM SDK for Senzor",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "worker": "./dist/index.mjs",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "require": "./dist/register.js",
      "import": "./dist/register.mjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "keywords": [
    "apm",
    "monitoring",
    "senzor",
    "node",
    "javascript",
    "api",
    "observability",
    "cloudflare-workers",
    "edge",
    "universal"
  ],
  "author": "Senzops",
  "license": "MIT"
}
